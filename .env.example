# URL of the running whisper.cpp server
WHISPER_SERVER_URL=http://127.0.0.1:8080

# Case-insensitive substring used to find the aggregate input device
# AGGREGATE_DEVICE_MATCH=aggregate
# BLACKHOLE_DEVICE_MATCH=blackhole

# Channel map inside the aggregate device (see `uv run main.py devices`)
# MIC_CHANNEL=0
# SYSTEM_CHANNELS=1,2
