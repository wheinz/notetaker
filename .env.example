# The notetaker starts its own temporary whisper.cpp server on this port.
# Port 8080 is reserved for the persistent dictation server.
# WHISPER_SERVER_HOST=127.0.0.1
# WHISPER_SERVER_PORT=8082
# WHISPER_SERVER_BIN=~/Documents/Github/whisper.cpp/build/bin/whisper-server
# WHISPER_MODELS_DIR=~/Documents/Github/whisper.cpp/models
# WHISPER_VAD_MODEL=~/Documents/Github/whisper.cpp/models/ggml-silero-v6.2.0.bin

# Case-insensitive substring used to find the aggregate input device
# AGGREGATE_DEVICE_MATCH=aggregate
# BLACKHOLE_DEVICE_MATCH=blackhole

# Windows recording: case-insensitive substrings to pick the WASAPI microphone
# and playback (output) device. Leave empty to use the Windows defaults.
# WINDOWS_MIC_DEVICE_MATCH=
# WINDOWS_OUTPUT_DEVICE_MATCH=

# Channel map inside the aggregate device (see `uv run main.py devices`)
# MIC_CHANNEL=0
# SYSTEM_CHANNELS=1,2

# Echo cancellation: subtracts speaker output from the microphone
# channel using the system audio as reference (NLMS adaptive filter).
# Enabling this reduces acoustic echo when using speakers.
# ECHO_CANCEL_ENABLED=false
# ECHO_CANCEL_FILTER_LENGTH=128
# ECHO_CANCEL_MU=0.1

# Text-level echo deduplication: if mic and system-audio transcript segments
# overlap, remove mic segments whose text is very similar to system audio.
# ECHO_DEDUP_ENABLED=true
# ECHO_DEDUP_SIMILARITY=0.72
# ECHO_DEDUP_OVERLAP_PADDING=0.75
# ECHO_DEDUP_MIN_WORDS=4

# Repetition deduplication: Whisper sometimes hallucinates the same phrase
# repeatedly on silence. Collapse consecutive near-identical segments within a
# single channel, keeping only the first occurrence.
# REPETITION_DEDUP_ENABLED=true
# REPETITION_DEDUP_SIMILARITY=0.85

# Silence filtering: drop segments whose no_speech_prob is at or above this
# threshold (whisper.cpp reports this per segment in verbose_json).
# NO_SPEECH_FILTER_ENABLED=true
# NO_SPEECH_THRESHOLD=0.6

# Voice activity detection: ask the whisper.cpp server to skip non-speech
# audio. Requires the Silero VAD model on the server (see README).
# VAD_ENABLED=true
